<body>

<div class="container">
    <h1>Reaction Test</h1>
    <button id="btn">Press W to Start</button>
    <div class="info">Complete 3 rounds</div>
</div>

<script>

const Btn = document.getElementById("btn");

let State = "ready";
let StartTime;
let Timer;
let Times = [];

document.addEventListener("keydown", function(E){

    if(E.key.toLowerCase() !== "w") return;

    // START ROUND
    if(State === "ready"){

        document.body.style.background = "#C62828"; // red
        Btn.textContent = "WAIT...";

        State = "waiting";

        let Delay = Math.random() * 3000 + 2000;

        Timer = setTimeout(() => {

            document.body.style.background = "#00FF00"; // bright green
            Btn.textContent = "PRESS W NOW!";

            StartTime = Date.now();
            State = "go";

        }, Delay);
    }

    // TOO SOON
    else if(State === "waiting"){

        clearTimeout(Timer);

        document.body.style.background = "#90EE90";
        Btn.textContent = "Too Soon! Press W to Restart";

        State = "ready";
    }

    // REACTION
    else if(State === "go"){

        let Reaction = Date.now() - StartTime;
        Times.push(Reaction);

        if(Times.length < 3){

            document.body.style.background = "#90EE90";
            Btn.textContent = "Round " + (Times.length + 1) + " - Press W";

            State = "ready";

        } else {

            let Sum = 0;
            for(let T of Times) Sum += T;

            let Avg = Math.round(Sum / Times.length);

            document.body.style.background = "#90EE90";
            Btn.textContent = "Average: " + Avg + " ms | Press W to restart";

            Times = [];
            State = "ready";
        }
    }

});

</script>

</body>
</html>