<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:Arial, sans-serif;
    background:#90EE90; /* light green */
    transition:none; /* IMPORTANT: no delay */
}

.container{
    text-align:center;
    background:rgba(0,0,0,0.25);
    padding:50px;
    border-radius:20px;
    box-shadow:0 15px 40px rgba(0,0,0,0.3);
}

h1{
    color:white;
    margin-bottom:30px;
}

button{
    font-size:28px;
    padding:25px 50px;
    border:none;
    border-radius:15px;
    background:white;
    font-weight:bold;
    min-width:420px;
}

.info{
    margin-top:20px;
    color:white;
}

</style>
